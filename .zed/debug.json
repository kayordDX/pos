[
  {
    "label": "Debug .NET Core App",
    "adapter": "netcoredbg",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/Pos.Api/bin/Debug/net10.0/Pos.Api.dll",
    "cwd": "${ZED_WORKTREE_ROOT}/Pos.Api",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "ASPNETCORE_URLS": "http://localhost:5117",
    },
    "build": {
      "command": "dotnet",
      "args": [
        "build",
        "${ZED_WORKTREE_ROOT}/Pos.Api/Pos.Api.csproj",
        "-p:Configuration=Debug",
      ],
    },
  },
]
