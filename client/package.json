		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-query": "^6.1.48",
		"@tanstack/svelte-table": "^9.2.4",
