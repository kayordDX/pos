{
	"name": "pos",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"eslint": "eslint . --fix",
		"format": "prettier --write .",
		"api": "pnpm run api:swagger && pnpm run api:orval",
		"api:swagger": "curl http://localhost:5117/openapi/v1.json > swagger.json",
		"api:orval": "orval"
	},
